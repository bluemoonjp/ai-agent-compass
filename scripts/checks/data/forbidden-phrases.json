{
  "groups": [
    {
      "id": "history",
      "scope": ["practices/**", "templates/**", "adapters/**", "plugins/**/SKILL.md", "AGENTS.md", "CLAUDE.md"],
      "patterns": [
        "used to",
        "formerly",
        "deprecated in favor of",
        "was changed to",
        "以前は",
        "かつては",
        "に変わった"
      ]
    },
    {
      "id": "false-premise",
      "scope": ["practices/**", "templates/**", "adapters/**", "plugins/**/SKILL.md", "AGENTS.md", "CLAUDE.md"],
      "excludeIfMatches": ["\\b(not|no|did ?n['o]t)\\b"],
      "patterns": ["138 (repos|repositories)", "LLM-generated.{0,80}(lowers|reduces).{0,80}success"]
    },
    {
      "id": "single-canon",
      "scope": ["templates/**", "plugins/**/SKILL.md"],
      "patterns": [
        "^#+\\s*.*Conflicting",
        "on (the|one) other hand",
        "some (argue|say|believe|prefer)",
        "opinions? (differ|vary)"
      ]
    }
  ]
}
