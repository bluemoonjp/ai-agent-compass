{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defs.schema.json",
  "$defs": {
    "status": {
      "enum": ["draft", "active"]
    },
    "topic": {
      "description": "Closed enum. Its initial values are the pilot content's topics only (#15); widen it only alongside content that uses the new value.",
      "enum": ["instruction-files", "docs"]
    },
    "appliesTo": {
      "enum": ["claude-code", "codex", "copilot", "gemini-cli", "cursor", "general"]
    },
    "sourceKind": {
      "enum": ["primary", "research", "other"]
    },
    "sourceConfidence": {
      "enum": ["verified", "unverified", "unavailable", "derived"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "kind", "confidence", "verified_on", "summary"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "kind": { "$ref": "#/$defs/sourceKind" },
        "confidence": { "$ref": "#/$defs/sourceConfidence" },
        "verified_on": {
          "type": "string",
          "description": "The last date this source was actually re-checked. The only place a verification date is recorded.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "summary": { "type": "string", "maxLength": 300 },
        "quote": { "type": "string", "maxLength": 300 },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "confidence": { "const": "verified" } }, "required": ["confidence"] },
          "then": { "required": ["quote"], "properties": { "quote": { "type": "string" } } }
        },
        {
          "if": { "properties": { "confidence": { "const": "unavailable" } }, "required": ["confidence"] },
          "then": { "required": ["note"], "properties": { "note": { "type": "string" } } }
        }
      ]
    }
  }
}
