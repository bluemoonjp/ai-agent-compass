{
  "permissions": {
    "allow": [
      "Bash(pnpm check *)",
      "PowerShell(pnpm check *)",
      "Bash(pnpm check:paste)",
      "PowerShell(pnpm check:paste)",
      "Bash(pnpm check)",
      "PowerShell(pnpm check)",
      "Bash(pnpm check --strict)",
      "PowerShell(pnpm check --strict)",
      "Bash(pnpm check:fast)",
      "PowerShell(pnpm check:fast)",
      "Bash(pnpm test)",
      "PowerShell(pnpm test)",
      "Bash(pnpm gen)",
      "PowerShell(pnpm gen)",
      "Bash(pnpm patrol)",
      "PowerShell(pnpm patrol)",
      "Bash(pnpm patrol:health)",
      "PowerShell(pnpm patrol:health)",
      "Bash(pnpm install --frozen-lockfile)",
      "PowerShell(pnpm install --frozen-lockfile)",
      "Bash(node --test)",
      "PowerShell(node --test)",
      "Bash(npx markdownlint-cli2 *)",
      "PowerShell(npx markdownlint-cli2 *)",
      "Bash(git fetch origin)",
      "PowerShell(git fetch origin)",
      "Bash(git branch -d *)",
      "PowerShell(git branch -d *)",
      "Bash(git branch -D *)",
      "PowerShell(git branch -D *)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit -m *)",
      "PowerShell(git commit -m *)",
      "Bash(git push -u origin *)",
      "PowerShell(git push -u origin *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(gh run list *)",
      "PowerShell(gh run list *)",
      "Bash(gh run view *)",
      "PowerShell(gh run view *)",
      "Bash(gh issue view *)",
      "PowerShell(gh issue view *)",
      "Bash(gh pr view *)",
      "PowerShell(gh pr view *)",
      "Bash(gh pr comment *)",
      "PowerShell(gh pr comment *)",
      "Bash(gh pr checks *)",
      "PowerShell(gh pr checks *)",
      "Bash(gh issue comment *)",
      "PowerShell(gh issue comment *)",
      "Bash(gh issue close *)",
      "PowerShell(gh issue close *)"
    ],
    "deny": [
      "Bash(gh secret *)",
      "PowerShell(gh secret *)",
      "Bash(gh repo edit *)",
      "PowerShell(gh repo edit *)",
      "Bash(gh repo delete *)",
      "PowerShell(gh repo delete *)",
      "Bash(gh api *graphql*)",
      "PowerShell(gh api *graphql*)",
      "Bash(gh api *visibility*)",
      "PowerShell(gh api *visibility*)",
      "Bash(gh api *private=*)",
      "PowerShell(gh api *private=*)",
      "Bash(gh api *secrets*)",
      "PowerShell(gh api *secrets*)",
      "Bash(gh api *git/refs*)",
      "PowerShell(gh api *git/refs*)",
      "Bash(git switch -c *)",
      "PowerShell(git switch -c *)",
      "Bash(git switch -C *)",
      "PowerShell(git switch -C *)",
      "Bash(git checkout -b *)",
      "PowerShell(git checkout -b *)",
      "Bash(git checkout -B *)",
      "PowerShell(git checkout -B *)",
      "Bash(git worktree add *)",
      "PowerShell(git worktree add *)",
      "Bash(git worktree remove *)",
      "PowerShell(git worktree remove *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git worktree add *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "Bash(git worktree remove *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "Bash(git switch -c *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "Bash(git switch -C *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "Bash(git checkout -b *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "Bash(git checkout -B *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "PowerShell(git worktree add *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "PowerShell(git worktree remove *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "PowerShell(git switch -c *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "PowerShell(git switch -C *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "PowerShell(git checkout -b *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          },
          {
            "type": "command",
            "if": "PowerShell(git checkout -B *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/deny-manual-worktree-and-branch-ops.mjs"]
          }
        ]
      }
    ]
  }
}
